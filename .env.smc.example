# SMC System Configuration - Environment Variables
# Copy this file to .env.smc and customize as needed

# === CORE SETTINGS ===
# Comma-separated list of symbols to analyze
SMC_SYMBOLS=BTCUSDT,ADAUSDT

# Timeframe for analysis
SMC_TIMEFRAME=1h

# === TRADING PARAMETERS ===
# Swing detection length (5-50)
SMC_SWING_LENGTH=10

# Box width multiplier for zones (1.0-10.0)
SMC_BOX_WIDTH=2.5

# Number of zones to keep in history (5-100)
SMC_HISTORY_LIMIT=20

# === PERFORMANCE SETTINGS ===
# Maximum memory usage in MB
SMC_MAX_MEMORY_MB=200

# Enable/disable caching (true/false)
SMC_ENABLE_CACHING=true

# Cache size in MB
SMC_CACHE_SIZE_MB=50

# === SYSTEM SETTINGS ===
# Debug mode (true/false)
SMC_DEBUG_MODE=false

# Log level (DEBUG, INFO, WARNING, ERROR)
SMC_LOG_LEVEL=INFO

# Enable performance profiling (true/false)
SMC_ENABLE_PROFILING=false

# === BINANCE API SETTINGS ===
# These should already be in your main .env file
# BINANCE_API_KEY=your_api_key_here
# BINANCE_SECRET_KEY=your_secret_key_here