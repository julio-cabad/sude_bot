# SMC System Configuration - Environment Variables
# Copy this file to .env and customize as needed

# Core Symbol Configuration (comma-separated list)
SMC_SYMBOLS=BTCUSDT,ETHUSDT,ADAUSDT,BNBUSDT,XRPUSDT,SOLUSDT,DOTUSDT,DOGEUSDT,AVAXUSDT,MATICUSDT

# Timeframe Configuration
SMC_TIMEFRAME=1h

# Trading Parameters
SMC_SWING_LENGTH=10
SMC_BOX_WIDTH=2.5
SMC_HISTORY_LIMIT=20
SMC_ATR_PERIOD=50

# Performance Settings
SMC_MAX_SYMBOLS=40
SMC_MAX_MEMORY_MB=500
SMC_BATCH_SIZE=10
SMC_MAX_WORKERS=8

# Cache Configuration
SMC_ENABLE_CACHING=true
SMC_CACHE_SIZE_MB=100
SMC_CACHE_TTL_SECONDS=300
SMC_CACHE_STRATEGY=lru

# System Settings
SMC_DEBUG_MODE=false
SMC_LOG_LEVEL=INFO
SMC_ENABLE_PROFILING=false

# Hot-reload Configuration
SMC_ENABLE_HOT_RELOAD=true

# API Configuration
SMC_TIMEOUT_SECONDS=30
SMC_MAX_RETRIES=3
SMC_RETRY_DELAY_SECONDS=5